/*
using the stack to reverse the array
*/

#include<iostream>
#include<vector>
#include<stack>
using namespace std;

void reverseRange(vector<int>& arr,int begin,int end)
{
    stack<int> st;
    int i = begin;
    int length = end - begin + 1 ;
    while(i < end + 1)
    {
        st.push(arr[i]);
        i++;
    }
    i = begin;
    while(i < end + 1)
    {
        arr[i] = st.top();
        st.pop(); //standard stack pop() do not return vlaue
        i ++;
    }
}


void rearrange(vector<int>& arr, int m,int n, int k)

{
    // reverse A 
    reverseRange(arr,0,m -1);
    //reverse B 
    reverseRange(arr,m,m + n -1);
    //reverse C  
    reverseRange(arr,m + n ,m + n + k-1);
    
    //reverse the whole array
    reverseRange(arr,0,m + n + k-1 );
}

int main()
{
    
    vector<int> arr = {
        1,2,3,
        21,22,
        41,42,43
    };
    int m = 3;
    int n = 2;
    int k = 3;
    
    cout<<"before reverse: \n";
    for(const int& x :arr){
        cout<<x<<" ";
    }
    
    //int length = arr.size(); // this  is the function to get the vector size
    rearrange(arr,m,n,k);
    cout<<"\n";
    cout<<"after reverse: \n";
    for(const int& x :arr){
        cout<<x<<" ";
    }
    return 0;
}
